<!doctype html>

<!-- ? Django load static & widget_tweaks --->
<!-- ! STRONGLY AFTER <!doctype html> !!! --->
{% if is_django_build %}
    {% raw %}
        {% load static %}
        {% load widget_tweaks %}
    {% endraw %}
{% endif %}

<html class="nojs" lang="{{ i18n.current.htmlLang }}">
    {% include "service/head.njk" %}
    <body
        {% if current_page__page_name == 'index' %}id="back-to-top"{% endif %}
        class="pt-[clamp(40px,0.0161*100vw+33.1566px,64px)] pb-[clamp(40px,0.0535*100vw+17.1888px,120px)]">
        <!-- * Preload scripts | Moved to 'head' --->
        {# {% include "service/scripts__preload.njk" %} #}

        <!-- * Cookie consent0.0089x + 14.838 --->
        {% include "components/cookie_consent.njk" %}

        <!-- * Hero intersection image --->
        <div class="intersection-images-container-wrapper">
            <div class="intersection-images-container">
                <img
                    data-aos="zoom-out"
                    data-aos-delay="150"
                    data-aos-duration="2500"
                    data-aos-easing="ease-out-cubic"
                    class="aos-item intersection-image intersection-image--layer-back"
                    data-my-picture-class="intersection-image-wrapper"
                    fetchpriority="high"
                    src="@images/hero/bg__layer_back.png"
                    alt="Hero background (layer back)" />
                <img
                    data-aos="zoom-out-up"
                    data-aos-delay="150"
                    data-aos-duration="2500"
                    data-aos-easing="ease-out-cubic"
                    class="aos-item intersection-image intersection-image--layer-middle"
                    data-my-picture-class="intersection-image-wrapper"
                    fetchpriority="high"
                    src="@images/hero/bg__layer_middle.png"
                    alt="Hero background (layer middle)" />
                <div
                    id="snow"
                    class=" intersection-image-snow"
                    data-count="500"
                    data-aos="zoom-in-left"
                    data-aos-delay="150"
                    data-aos-duration="2500"
                    data-aos-easing="ease-out-cubic"></div>
                <img
                    data-aos="zoom-out-right"
                    data-aos-delay="150"
                    data-aos-duration="2500"
                    data-aos-easing="ease-out-cubic"
                    class="aos-item intersection-image intersection-image--layer-front"
                    data-my-picture-class="intersection-image-wrapper"
                    fetchpriority="high"
                    src="@images/hero/bg__layer_front.png"
                    alt="Hero background (layer front)" />
            </div>
        </div>

        <!-- ! Page content START --->
        {% include "common/header.njk" %}
        <main id="page-content">{% block content %}{% endblock %}</main>
        {% include "common/footer.njk" %}
        <!-- ! Page content END --->

        <!-- * Postload scripts --->
        {% include "service/scripts__postload.njk" %}
    </body>
</html>
